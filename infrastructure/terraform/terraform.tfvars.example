# ==============================================================================
# IncidentX AI — Example Terraform Variable Values
# Copy this file to terraform.tfvars and populate with environment-specific values
# ==============================================================================

aws_region  = "us-east-1"
environment = "production"

vpc_cidr              = "10.100.0.0/16"
availability_zones    = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs   = ["10.100.1.0/24", "10.100.2.0/24", "10.100.3.0/24"]
private_subnet_cidrs  = ["10.100.11.0/24", "10.100.12.0/24", "10.100.13.0/24"]
database_subnet_cidrs = ["10.100.21.0/24", "10.100.22.0/24", "10.100.23.0/24"]

db_instance_class    = "db.r6g.xlarge"
db_allocated_storage = 100
db_multi_az          = true
db_name              = "incidentx_prod"
db_username          = "incidentx_admin"

backend_cpu           = 2048
backend_memory        = 4096
backend_desired_count = 3
backend_min_count     = 2
backend_max_count     = 10

frontend_desired_count = 2

container_image_backend  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/incidentx-backend:v1.0.0"
container_image_frontend = "123456789012.dkr.ecr.us-east-1.amazonaws.com/incidentx-frontend:v1.0.0"

domain_name = "incidentx.enterprise.internal"
