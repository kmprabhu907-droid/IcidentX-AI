# INCIDENTX AI — Environment Configuration Template
# Copy this file to .env and configure local values

# App & Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Frontend Service
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Database (PostgreSQL)
POSTGRES_USER=incidentx_admin
POSTGRES_PASSWORD=incidentx_dev_password
POSTGRES_DB=incidentx_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://incidentx_admin:incidentx_dev_password@localhost:5432/incidentx_db

# LLM Provider Configuration
# Supported: gemini, openai, anthropic, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Observability Integrations
PROMETHEUS_ENDPOINT=http://localhost:9090
OPENTELEMETRY_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=incidentx-backend

# Security & Governance
ENABLE_EXECUTION_GUARDRAILS=true
REQUIRE_HUMAN_APPROVAL_MUTATION=true
SLACK_WEBHOOK_URL=
